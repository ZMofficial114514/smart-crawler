# ============================================================
# SmartCrawler 环境变量模板
# 复制为 .env 后按需修改; 嵌套层级用双下划线 __ 表示
# 敏感信息(API Key/代理)只放这里或真实环境变量, 不要写进代码
# ============================================================

# ---------- 日志 ----------
SC_LOG_LEVEL=INFO
# SC_LOG_FILE=logs/smartcrawler.log

# ---------- 浏览器 ----------
# SC_BROWSER__ENGINE=chromium          # chromium / firefox / webkit
# SC_BROWSER__HEADLESS=true
# SC_BROWSER__TIMEOUT=30
# SC_BROWSER__USER_AGENT=              # 留空则随机 UA
# SC_BROWSER__MAX_PAGES=4              # 同时打开页面数上限
# SC_BROWSER__STEALTH=true             # 指纹伪装注入
# SC_BROWSER__STORAGE_STATE=           # 会话持久化文件, 如 data/session.json

# ---------- 网络监听 ----------
# SC_NETWORK__CAPTURE_RESOURCE_TYPES=["xhr","fetch","websocket"]
# SC_NETWORK__MAX_BODY_SIZE=1000000
# SC_NETWORK__DUMP_JSONL=false
# SC_NETWORK__JSONL_PATH=data/network.jsonl

# ---------- AI 辅助 ----------
# provider=openai 表示任意 OpenAI 兼容接口(DeepSeek/通义/智谱/Moonshot/硅基流动等)
# provider=ollama 表示本地 Ollama(默认 http://localhost:11434/v1, 无需 Key)
# SC_AI__PROVIDER=openai
# SC_AI__BASE_URL=https://api.deepseek.com/v1
# SC_AI__MODEL=deepseek-chat
SC_AI__API_KEY=
# API Key 也可用通用变量(自动回落识别):
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=
# SILICONFLOW_API_KEY=
# SC_AI__OFFLINE=false                # true=纯规则引擎, 不调用 AI
# SC_AI__CACHE_ENABLED=true

# ---------- 反爬与稳定性 ----------
# SC_ANTI_SPIDER__ROTATE_USER_AGENT=true
# SC_ANTI_SPIDER__RANDOM_DELAY_RANGE=[1.0,3.0]   # 随机限速区间(秒), 合规默认值
# SC_ANTI_SPIDER__MAX_RETRIES=3
# SC_ANTI_SPIDER__RESPECT_ROBOTS=true            # robots.txt 合规开关, 默认遵守
# 代理池(二选一): 配置数组或 PROXY_POOL 环境变量(逗号分隔)
# SC_ANTI_SPIDER__PROXIES=["http://user:pass@host:port","socks5://host:port"]
# PROXY_POOL=

# ---------- 存储输出 ----------
# SC_STORAGE__DEFAULT_FORMAT=json      # json / jsonl / csv / sqlite
# SC_STORAGE__OUTPUT_DIR=data
# SC_STORAGE__SQLITE_PATH=data/smartcrawler.db
# SC_STORAGE__WEBHOOK_URL=             # 抓取完成后 POST 结果

# ---------- 爬虫行为 ----------
# SC_CRAWLER__MAX_DEPTH=1              # 分页最大页数
# SC_CRAWLER__MAX_ITEMS=500
# SC_CRAWLER__NETWORK_SETTLE=2.5       # 页面加载后等待异步请求的时间(秒)
# SC_CRAWLER__INCREMENTAL=false
# SC_CRAWLER__STATE_PATH=data/state.json

# ---------- 调试服务 ----------
# SC_API__HOST=127.0.0.1
# SC_API__PORT=8322
