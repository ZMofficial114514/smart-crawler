#!/bin/sh
# ============================================================
# pre-push 钩子: 推送前扫描密钥
# ------------------------------------------------------------
# 这是**最后一道防线**。日常最危险的场景是随手 `git add -A` 把 .env 加进来 ——
# .gitignore 能挡住未被跟踪的文件, 但挡不住"已经被 add 过"的。
# 这里在推送前再查一遍, 命中就中止推送。
#
# 想临时跳过: git push --no-verify
# ============================================================

echo "[pre-push] 正在检查是否有密钥/凭据会被推送…"

# 优先用项目虚拟环境的解释器, 回退到系统 python
PY=""
if [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PY="python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
fi

if [ -z "$PY" ]; then
    echo "[pre-push] 找不到 python, 跳过密钥检查(建议手动跑 scripts/check_no_secrets.py)"
    exit 0
fi

if [ ! -f "scripts/check_no_secrets.py" ]; then
    echo "[pre-push] 找不到 scripts/check_no_secrets.py, 跳过"
    exit 0
fi

"$PY" scripts/check_no_secrets.py
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
    echo ""
    echo "============================================================"
    echo " [pre-push] 已阻止推送: 检测到疑似密钥泄露"
    echo ""
    echo " 请先处理, 再重新推送。如果确认是误报, 可用:"
    echo "     git push --no-verify"
    echo "============================================================"
    exit 1
fi

echo "[pre-push] 通过, 未发现密钥泄露"
exit 0
